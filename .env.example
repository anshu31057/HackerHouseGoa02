# SARVAM_API_KEY: Required for Sarvam AI Speech-to-Text transcription.
# If not provided, the web client will automatically use browser Web Speech STT or mock/audio simulation.
SARVAM_API_KEY=""

# GEMINI_API_KEY: Default platform variable
GEMINI_API_KEY=""

# APP_URL: The URL where this applet is hosted.
APP_URL="http://localhost:3000"

PORT=3000

